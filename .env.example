# Copie para .env.local e preencha com os valores do painel do Supabase
# (Settings → API). NUNCA commitar .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=chave-anon-aqui

# Só no servidor — jamais expor no front
SUPABASE_SERVICE_ROLE_KEY=chave-service-role-aqui

# String do pooler (Session mode, porta 5432) — usada para aplicar migrações
SUPABASE_DB_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# ------------------------------------------------------------
# WhatsApp Cloud API (Meta) — Embedded Signup
# Criar em developers.facebook.com: app do tipo Business com o
# produto "WhatsApp" + configuração de Embedded Signup.
# ------------------------------------------------------------
NEXT_PUBLIC_META_APP_ID=id-do-app-meta
NEXT_PUBLIC_META_ES_CONFIG_ID=id-da-configuracao-embedded-signup
# Só no servidor — usado para trocar o code pelo token
META_APP_SECRET=segredo-do-app-meta
# Token inventado por você; o mesmo valor vai no painel de webhooks da Meta
WHATSAPP_WEBHOOK_VERIFY_TOKEN=um-token-secreto-qualquer
